# Backend server
PORT=7001
HOST=0.0.0.0

# Production hosting. In NODE_ENV=production both options default to true.
# Paths support `~/`; defaults are the two files shown below.
# Never commit certificate private keys or copy them into this repository.
# SERVE_CLIENT_BUILD=true
# CLIENT_DIST_DIR=/absolute/path/to/chatbot/client/dist
# HTTPS_ENABLED=true
# HTTPS_CERT_PATH=~/devhttps/dev-cert.pem
# HTTPS_KEY_PATH=~/devhttps/dev-key.pem
# HTTPS_CA_PATH=/absolute/path/to/optional-ca-chain.pem

# Single-user authentication. Production enables authentication by default and
# refuses to start until these values are configured. Generate the password hash
# and two independent secrets with the commands documented in README.md.
# Development defaults to disabled unless AUTH_ENABLED=true is set explicitly.
# AUTH_ENABLED=true
# AUTH_USERNAME=local-user
# AUTH_PASSWORD_HASH=replace_with_argon2id_hash
# AUTH_ACCESS_TOKEN_SECRET=replace_with_random_access_secret
# AUTH_REFRESH_TOKEN_SECRET=replace_with_different_random_refresh_secret
# AUTH_ACCESS_TTL_SECONDS=900
# AUTH_REFRESH_TTL_SECONDS=604800
# AUTH_COOKIE_SECURE=true
# AUTH_SESSION_DB_PATH=/absolute/path/to/chatbot-data/auth-sessions.sqlite3
# AUTH_ALLOWED_ORIGINS=https://optional-additional-origin.example

# Personal profile displayed in the React sidebar.
APP_PROFILE_NAME=Jason Wang
APP_PROFILE_AVATAR_URL=/assets/jw.svg

# Default LLM provider. Legacy LLM_* values apply to the selected default provider.
LLM_PROVIDER=deepseek
LLM_ENDPOINT=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=30000
# Optional provider defaults. Request-level UI settings can override these values.
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096
# Comma-separated model ids shown as disabled in the UI and rejected by the backend.
# LLM_DISABLED_MODELS=gpt-5.6-sol

# DeepSeek thinking/reasoning
# LLM_REASONING_ENABLED accepts true/false, 1/0, yes/no, on/off.
LLM_REASONING_ENABLED=true
LLM_REASONING_EFFORT=max
DEEPSEEK_API_KEY=replace_with_your_api_key

# Optional provider-specific configuration for request-level switching.
# OPENAI_ENDPOINT accepts a base URL, a /v1 URL, or a full /v1/responses URL.
# DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TEMPERATURE=0.7
# DEEPSEEK_MAX_TOKENS=4096
# DEEPSEEK_REASONING_ENABLED=true
# DEEPSEEK_REASONING_EFFORT=max
# DEEPSEEK_CONTEXT_WINDOW_TOKENS=131072
# OPENAI_ENDPOINT=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_API_KEY=replace_with_your_api_key
# OPENAI_MAX_TOKENS=4096
# OPENAI_REASONING_ENABLED=true
# OPENAI_REASONING_EFFORT=medium
# OPENAI_CONTEXT_WINDOW_TOKENS=400000
# OpenAI models in the current catalog do not accept temperature.
# Provider-specific values take precedence. LLM_* values only apply to the
# selected default provider. DeepSeek ignores temperature in thinking mode.
# DeepSeek accepts low/high/max; the compatibility value medium maps to high.

# Context management
# Provider context windows default to the local model catalog values above. Override only
# when the configured compatible endpoint exposes a different verified limit.
# History message/character values remain secondary guardrails. The Provider-aware token
# budget also includes the system prompt, summary, current question, images, tools and output reserve.
CONTEXT_MAX_HISTORY_MESSAGES=20
CONTEXT_MAX_HISTORY_CHARS=12000
ATTACHMENT_ORPHAN_TTL_MS=86400000
# Maximum total prompt content per rolling summary request. Values below 8000 fall back to 24000.
SUMMARY_MAX_INPUT_CHARS=24000

# Weather tool
HEFENG_API_HOST=replace_with_weather_api_host
HEFENG_API_KEY=replace_with_weather_api_key

# Optional local data override
# Supported CONVERSATION_STORE values:
# - file, json, fs: file-backed JSON storage
# - sqlite, sqlite3: SQLite storage
CONVERSATION_STORE=sqlite
# CONVERSATION_DATA_DIR=/absolute/path/to/chatbot-data
# CONVERSATION_FILE_DATA_DIR=/absolute/path/to/chatbot-data/file
# CONVERSATION_DB_PATH=/absolute/path/to/chatbot-data/sqlite/conversations.sqlite3

# Real-provider CDP test tuning
# These are shell-level variables read by tests/cdp/*.mjs when you run
# `bun run test:cdp:real`. Keep them commented unless you need overrides.
# APP_URL=http://127.0.0.1:5173/
# BACKEND_URL=http://127.0.0.1:7001/
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CDP_SCREENSHOTS=0
# CDP_REAL_WAIT_TIMEOUT_MS=120000
# CDP_REAL_CONTEXT_WAIT_TIMEOUT_MS=180000
# CDP_REAL_MARKDOWN_WAIT_TIMEOUT_MS=240000
# CDP_REAL_OPENAI_WAIT_TIMEOUT_MS=240000
# CDP_SCRIPT_RETRIES=0
# CDP_REAL_SCRIPT_RETRIES=0
