{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch ./bin/www.ts",
    "start": "node ./bin/www.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test ../tests/server/*.test.ts",
    "test:context": "node --test ../tests/server/contextService.test.ts",
    "test:conversation-export": "node --test ../tests/server/conversationExport.test.ts ../tests/server/conversationExportSqlite.test.ts",
    "test:conversation-search": "node --test ../tests/server/conversationSearch.test.ts ../tests/server/conversationSearchSqlite.test.ts",
    "test:conversation-summary": "node --test ../tests/server/conversationSummary.test.ts ../tests/server/conversationSummarySqlite.test.ts",
    "test:conversation-import": "node --test ../tests/server/conversationImport.test.ts ../tests/server/conversationImportSqlite.test.ts",
    "test:model-options": "node --test ../tests/server/modelOptions.test.ts ../tests/server/providerConfig.test.ts",
    "test:tools": "node --test ../tests/server/toolService.test.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "debug": "4.4.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "http-errors": "2.0.1",
    "morgan": "1.11.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/debug": "4.1.13",
    "@types/express": "5.0.6",
    "@types/http-errors": "2.0.5",
    "@types/morgan": "1.9.10",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
