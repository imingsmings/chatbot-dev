{
  "name": "chatbot-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.18.0"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#api/*": "./src/api/*.ts",
    "#auth/*": "./src/auth/*.ts",
    "#types/*": "./src/types/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run typecheck && bun run build-only",
    "build-only": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "bun --bun tsc -b --pretty false",
    "lint": "bun run --cwd .. lint:client",
    "lint:standard": "bun run --cwd .. lint:client:standard",
    "lint:type-aware": "bun run --cwd .. lint:client:type-aware",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run",
    "test:watch": "bun --bun vitest"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.13",
    "highlight.js": "11.11.1",
    "lucide-react": "1.28.0",
    "markdown-it": "14.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/markdown-it": "14.1.2",
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
