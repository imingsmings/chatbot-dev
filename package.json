{
  "name": "chatbot-dev",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "30.0.1",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vitest": "4.1.10"
  },
  "scripts": {
    "dev:server": "bun run --cwd server dev",
    "dev:bun-server": "bun run --cwd bun-server dev",
    "dev:client": "bun run --cwd client dev",
    "start:server": "bun run --cwd server start",
    "start:bun-server": "bun run --cwd bun-server start",
    "start:production": "NODE_ENV=production SERVE_CLIENT_BUILD=true HTTPS_ENABLED=true bun run --cwd server start",
    "typecheck:server": "bun run --cwd server typecheck",
    "typecheck:bun-server": "bun run --cwd bun-server typecheck",
    "typecheck:client": "bun run --cwd client typecheck",
    "build:client": "bun run --cwd client build",
    "build": "bun run check && bun run build:client",
    "docker:config": "docker compose config",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:up:volume": "docker compose -f compose.yaml -f compose.data-volume.yaml up -d --build",
    "docker:stop": "docker compose stop chatbot",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f chatbot",
    "docker:status": "docker compose ps",
    "docker:backup": "node scripts/docker-volume-backup.mjs",
    "docker:restore": "node scripts/docker-volume-restore.mjs",
    "lint:client": "bun run lint:client:standard && bun run lint:client:type-aware",
    "lint:client:standard": "bun --bun oxlint client tests/client -D correctness --deny-warnings",
    "lint:client:type-aware": "bun --bun oxlint client tests/client --type-aware -D correctness --deny-warnings",
    "check": "bun run typecheck:server && bun run typecheck:bun-server && bun run typecheck:client && bun run lint:client",
    "audit:production": "bun audit --audit-level=high",
    "test:context": "node --test ./tests/server/contextService.test.ts",
    "test:conversation-export": "node --test ./tests/server/conversationExport.test.ts ./tests/server/conversationExportSqlite.test.ts",
    "test:conversation-search": "node --test ./tests/server/conversationSearch.test.ts ./tests/server/conversationSearchSqlite.test.ts",
    "test:conversation-summary": "node --test ./tests/server/conversationSummary.test.ts ./tests/server/conversationSummarySqlite.test.ts",
    "test:conversation-import": "node --test ./tests/server/conversationImport.test.ts ./tests/server/conversationImportSqlite.test.ts",
    "test:model-options": "node --test ./tests/server/modelOptions.test.ts ./tests/server/providerConfig.test.ts",
    "test:llm-adapter": "node --test ./tests/server/deepseekAdapter.test.ts ./tests/server/openaiAdapter.test.ts ./tests/server/openaiFlow.test.ts",
    "test:tools": "node --test ./tests/server/toolService.test.ts",
    "test:server": "node --test ./tests/server/*.test.ts",
    "test:bun-server": "bun test --timeout=30000 --isolate --parallel=1 ./tests/bun-server",
    "test:backend-parity": "bun ./tests/runtime/backend-parity.mjs",
    "test:toolchain": "bun test ./tests/runtime/bunToolchain.test.ts",
    "benchmark:backends": "bun ./tests/runtime/backend-benchmark.mjs",
    "test:client": "bun run --cwd client test:unit",
    "test:unit": "bun run test:server && bun run test:bun-server && bun run test:client",
    "test:cdp:p0": "bun tests/cdp/run-cdp-regression.mjs p0",
    "test:cdp:p1": "bun tests/cdp/run-cdp-regression.mjs p1",
    "test:cdp:ui": "bun tests/cdp/run-cdp-regression.mjs ui",
    "test:cdp:context-debug": "bun tests/cdp/run-cdp-regression.mjs context-debug",
    "test:cdp:conversation-export": "bun tests/cdp/run-cdp-regression.mjs conversation-export",
    "test:cdp:conversation-search": "bun tests/cdp/run-cdp-regression.mjs conversation-search",
    "test:cdp:roadmap": "bun tests/cdp/run-cdp-regression.mjs roadmap",
    "test:cdp:sidebar-state": "bun tests/cdp/run-cdp-regression.mjs sidebar-state",
    "test:cdp:markdown": "bun tests/cdp/run-cdp-regression.mjs markdown",
    "test:cdp:highlight": "bun tests/cdp/run-cdp-regression.mjs highlight",
    "test:cdp:docker-ui": "bun tests/cdp/run-cdp-regression.mjs docker-ui",
    "test:cdp:model-options-persistence": "bun tests/cdp/run-cdp-regression.mjs model-options-persistence",
    "test:cdp:prompt-templates": "bun tests/cdp/run-cdp-regression.mjs prompt-templates",
    "test:cdp:stream-performance": "bun tests/cdp/run-cdp-regression.mjs stream-performance",
    "test:cdp:request-recovery": "bun tests/cdp/run-cdp-regression.mjs request-recovery",
    "test:cdp:authentication": "bun tests/cdp/run-cdp-regression.mjs authentication",
    "test:cdp:image-attachments": "bun tests/cdp/run-cdp-regression.mjs image-attachments",
    "test:cdp:all-mock": "bun tests/cdp/run-cdp-regression.mjs all-mock",
    "test:cdp:all-mock:bun": "CHATBOT_SERVER_DIR=bun-server CHATBOT_SERVER_RUNTIME=bun bun tests/cdp/run-cdp-regression.mjs all-mock",
    "test:cdp:all-real": "bun tests/cdp/run-all-real.mjs",
    "test:cdp:real-openai": "CDP_REAL_SUITE=real-openai bun tests/cdp/run-all-real.mjs",
    "test:cdp:real-vision": "CDP_REAL_SUITE=real-vision bun tests/cdp/run-all-real.mjs",
    "test:cdp:real-model-options": "CDP_REAL_SUITE=real-model-options bun tests/cdp/run-all-real.mjs",
    "test:cdp:real": "CDP_REAL_SUITE=real bun tests/cdp/run-all-real.mjs",
    "test:docker": "node tests/docker/container-smoke.mjs"
  },
  "workspaces": {
    "packages": [
      "client",
      "server",
      "bun-server"
    ],
    "catalog": {
      "@types/node": "22.20.1",
      "bun-types": "1.4.0",
      "typescript": "7.0.2"
    }
  },
  "trustedDependencies": [
    "argon2"
  ],
  "overrides": {
    "fast-uri": "3.1.7"
  }
}
